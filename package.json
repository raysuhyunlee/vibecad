{
  "name": "vibecad",
  "version": "0.1.0",
  "productName": "Vibecad",
  "description": "A CAD for agents, and a feedback system for humans",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "vibecad": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "app/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "app": "electron ."
  },
  "build": {
    "appId": "dev.vibecad.app",
    "productName": "Vibecad",
    "asar": false,
    "files": [
      "app/**",
      "src/**",
      "viewer/**",
      "libs/**",
      "factories/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "app/node_modules/three/examples/jsm"
      }
    ],
    "publish": { "provider": "github", "owner": "raysuhyunlee", "repo": "vibecad" },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "app/entitlements.mac.plist",
      "entitlementsInherit": "app/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Vibecad listens while you hold Space to talk."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "electron-updater": "6.8.11",
    "occt-wasm": "5.16.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2"
  }
}
