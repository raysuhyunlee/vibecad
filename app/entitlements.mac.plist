<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime, which notarization needs, blocks these unless they are granted. -->
<plist version="1.0">
  <dict>
    <!-- V8 and the occt and onnx WebAssembly kernels compile code at run time. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native modules such as onnxruntime are signed apart from the app. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Voice input. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
